{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@seeway/agents": ["packages/agents/src/index.ts"],
      "@seeway/contracts": ["packages/contracts/src/index.ts"],
      "@seeway/control-plane": ["packages/control-plane/src/index.ts"],
      "@seeway/time-core": ["packages/time-core/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "tests/**/*.ts"
  ]
}
