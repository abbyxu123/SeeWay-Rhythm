{
  "name": "seeway-rhythm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "audit:qimen-golden": "vite-node --script scripts/qimen-golden-audit.ts",
    "audit:qimen-sources": "vite-node --script scripts/qimen-source-audit.ts",
    "device:bundle": "vite-node --script scripts/qimen-device-bundle.ts",
    "generate:qimen-golden-schema": "vite-node scripts/generate-qimen-golden-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.base.json"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.7",
    "zod": "4.1.5"
  }
}
